rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // This workspace is being used as a single-owner account.
    // Only authenticated Firebase users can access workspace records.
    // Keep only the owner's account in Firebase Authentication.
    match /accounting/{recordId} {
      allow read, create, update, delete: if signedIn();
    }
    match /business/{recordId} {
      allow read, create, update, delete: if signedIn();
    }
    match /deliveries/{recordId} {
      allow read, create, update, delete: if signedIn();
    }
    match /inventory/{recordId} {
      allow read, create, update, delete: if signedIn();
    }
    match /notes/{noteId} {
      allow read, create, update, delete: if signedIn();
    }
    match /vault/{recordId} {
      allow read, create, update, delete: if signedIn();
    }

    // No role-management or user-profile collection is used.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}